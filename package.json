    "i18n:manifest": "node scripts/build-i18n-manifest.mjs",
    "test:render": "node test/consumer/fixtures/plain/list-snapshot.mjs && node test/consumer/fixtures/plain/form-actions-snapshot.mjs && node test/consumer/fixtures/plain/write-access.mjs && node test/consumer/fixtures/plain/status-context.mjs && node test/consumer/fixtures/plain/showcase-render.mjs && node test/consumer/fixtures/plain/sticky-links.mjs && node test/consumer/fixtures/plain/screens-render.mjs && node test/consumer/fixtures/plain/issues-render.mjs && node test/consumer/fixtures/plain/database-render.mjs && node test/consumer/fixtures/plain/crons-render.mjs && node test/consumer/fixtures/plain/files-render.mjs && node test/consumer/fixtures/plain/screens-options-render.mjs && node test/consumer/fixtures/plain/shell-render.mjs && node test/consumer/fixtures/plain/shell-options-render.mjs && node test/consumer/fixtures/plain/options-render.mjs && node test/consumer/fixtures/plain/options-033-render.mjs && node test/consumer/fixtures/plain/options-034-render.mjs && node test/consumer/fixtures/plain/options-037-render.mjs && node test/consumer/fixtures/plain/options-039-render.mjs && node test/consumer/fixtures/plain/options-0310-render.mjs && node test/consumer/fixtures/plain/options-0312-render.mjs && node test/consumer/fixtures/plain/design-studio-render.mjs && node test/consumer/fixtures/plain/pure-require.cjs",
    "prepack": "pnpm build"
  },
