{
  "name": "@mgamadeus/ddd-admin-ui",
  "version": "0.1.0-rc.2",
  "description": "Admin UI building blocks for React 19 / Next 16 / Tailwind 4 apps on @mgamadeus/ddd-web: entity lists (table and card grid, filters, selection, bulk actions), page frames and detail shells, form shells with conditional fields and server validation, translatable inputs, media pickers, Next adapters, a provider, and the shadcn-style primitives they are drawn with, plus two stylesheets and two JSON manifests.",
  "keywords": [
    "ddd",
    "mgamadeus",
    "admin",
    "react",
    "nextjs",
    "tailwindcss",
    "shadcn",
    "radix-ui",
    "ui-components"
  ],
  "homepage": "https://github.com/ddd-framework/ddd-admin-ui#readme",
  "bugs": {
    "url": "https://github.com/ddd-framework/ddd-admin-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddd-framework/ddd-admin-ui.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./logic": {
      "types": "./dist/logic/index.d.ts",
      "default": "./dist/logic/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./list": {
      "types": "./dist/list/index.d.ts",
      "default": "./dist/list/index.js"
    },
    "./page": {
      "types": "./dist/page/index.d.ts",
      "default": "./dist/page/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./translations": {
      "types": "./dist/translations/index.d.ts",
      "default": "./dist/translations/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./glass": {
      "types": "./dist/glass/index.d.ts",
      "default": "./dist/glass/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    },
    "./notify-sonner": {
      "types": "./dist/notify-sonner/index.d.ts",
      "default": "./dist/notify-sonner/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./components.css": "./dist/components.css",
    "./tokens.json": "./dist/tokens.json",
    "./i18n-keys.json": "./dist/i18n-keys.json"
  },
  "bin": {
    "ddd-admin-ui": "./dist/cli/ddd-admin-ui.js",
    "ddd-admin-ui-check-radix": "./dist/scripts/check-radix.mjs",
    "ddd-admin-ui-check-tokens": "./dist/scripts/check-tokens.mjs",
    "ddd-admin-ui-i18n-manifest": "./dist/scripts/build-i18n-manifest.mjs"
  },
  "files": [
    "dist",
    ".claude/skills",
    "README.md",
    "STANDARDS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\" \"test/unit/**/*.test.ts\" \"test/check-package/**/*.test.ts\"",
    "check-package": "node scripts/check-package.mjs --dir .",
    "i18n:manifest": "node scripts/build-i18n-manifest.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@mgamadeus/ddd-web": ">=0.13.0 <1",
    "lucide-react": ">=0.550.0 <2",
    "next": "^16.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mgamadeus/ddd-web": "^0.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  }
}
