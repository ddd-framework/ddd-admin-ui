    "warning-text": {
      "meaning": "warning status as legible text (StatusBadge, callouts, delta text, field errors); optional, falls back to --warning; theme.css binds text-warning to it",
      "themed": true,
      "required": false,
      "fallback": "warning",
      "utilities": []
