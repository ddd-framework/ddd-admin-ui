{
  "$comment": "The host contract of the blocks and primitives: colour roles (utilities the host's Tailwind build must provide), plain custom properties on :root (and .dark when themed), the layer defaults components.css sets, the data attributes the CSS reads. Checked against a built stylesheet by scripts/check-tokens.mjs.",
  "version": 1,
  "colors": {
    "background": {
      "meaning": "page backdrop",
      "themed": true,
      "utilities": [
        "bg-background",
        "bg-background/20",
        "bg-background/85",
        "border-background",
        "ring-offset-background",
        "text-background"
