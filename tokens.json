    },
    "data-shell-content": {
      "setBy": "AppShell",
      "readBy": "components.css"
    },
    "data-shell-sidebar": {
      "setBy": "ShellSidebar",
      "readBy": "host shell"
    },
    "data-shell-topbar": {
      "setBy": "ShellTopBar",
      "readBy": "host shell"
    },
    "data-shell-scrolled": {
