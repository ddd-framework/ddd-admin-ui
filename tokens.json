      "themed": true,
      "required": false,
      "fallback": "warning/15",
      "utilities": []
    },
    "destructive-soft": {
      "meaning": "soft danger surface behind badges (the bg-destructive/15 tint); optional, falls back to --destructive at 15 % (color-mix in oklab); theme.css binds bg-destructive/15 to it",
      "themed": true,
      "required": false,
      "fallback": "destructive/15",
      "utilities": []
    },
    "info-soft": {
      "meaning": "soft info surface behind badges (the bg-info/15 tint); optional, falls back to --info at 15 % (color-mix in oklab); theme.css binds bg-info/15 to it",
      "themed": true,
      "required": false,
      "fallback": "info/15",
      "utilities": []
    },
    "brand": {
      "meaning": "identity fill and marks (with /15 tints)",
      "themed": true,
      "utilities": [
        "bg-brand",
        "bg-brand/15",
        "text-brand"
      ]
    },
    "brand-emphasis": {
      "meaning": "brand as legible text",
      "themed": true,
      "utilities": [
        "text-brand-emphasis"
      ]
    },
    "brand-light": {
      "meaning": "light brand tint (brand Tag)",
      "themed": true,
      "utilities": [
        "bg-brand-light",
        "text-brand-light"
      ]
    },
    "brand-ink": {
      "meaning": "brand text at least 4.5:1 (action rows, two-tone titles)",
      "themed": true,
      "utilities": [
        "bg-brand-ink/25",
        "text-brand-ink"
      ]
    },
    "border": {
      "meaning": "hairline; also the default border colour",
      "themed": true,
      "utilities": [
        "bg-border",
        "border-border"
      ]
    },
    "input": {
      "meaning": "field border, dark-mode field fill",
      "themed": true,
      "utilities": [
        "bg-input",
        "bg-input/30",
        "bg-input/50",
        "bg-input/80",
        "border-input"
      ]
    },
    "ring": {
      "meaning": "focus ring",
      "themed": true,
      "utilities": [
        "border-ring",
        "ring-ring",
        "ring-ring/50"
