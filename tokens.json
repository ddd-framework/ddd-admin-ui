    "data-list-overflow-start": {
      "setBy": "EntityListTable",
      "readBy": "components.css"
    },
    "data-list-overflow-end": {
      "setBy": "EntityListTable",
      "readBy": "components.css"
    },
    "data-shell": {
      "setBy": "AppShell",
      "readBy": "host shell"
    },
    "data-shell-collapsed": {
      "setBy": "AppShell",
