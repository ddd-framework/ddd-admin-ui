{
  "$comment": "The host contract of the blocks and primitives: colour roles (utilities the host's Tailwind build must provide), plain custom properties on :root (and .dark when themed), the layer defaults components.css sets, the data attributes the CSS reads. Checked against a built stylesheet by scripts/check-tokens.mjs.",
  "version": 1,
  "colors": {
    "background": {
      "meaning": "page backdrop",
      "themed": true,
      "utilities": [
        "bg-background",
        "bg-background/20",
        "bg-background/85",
        "ring-offset-background",
        "text-background"
      ]
    },
    "foreground": {
      "meaning": "default text on background and card",
      "themed": true,
      "utilities": [
        "bg-foreground",
        "bg-foreground/15",
        "bg-foreground/5",
        "fill-foreground",
        "ring-foreground/5",
        "text-foreground"
      ]
    },
    "card": {
      "meaning": "surface fill; components.css mixes it with --surface-alpha",
      "themed": true,
      "utilities": [
        "bg-card",
        "bg-card/90"
      ]
    },
    "card-foreground": {
      "meaning": "text on card",
      "themed": true,
      "utilities": [
        "text-card-foreground"
      ]
    },
    "popover": {
      "meaning": "menus, selects, popovers",
      "themed": true,
      "utilities": [
        "bg-popover"
      ]
    },
    "popover-foreground": {
      "meaning": "text on popover",
      "themed": true,
      "utilities": [
        "text-popover-foreground"
      ]
    },
    "primary": {
      "meaning": "action fill (buttons, active chips, counters)",
      "themed": true,
      "utilities": [
        "bg-primary",
        "bg-primary/15",
        "bg-primary/25",
        "bg-primary/90",
        "border-primary",
        "text-primary",
        "via-primary"
      ]
    },
    "primary-foreground": {
      "meaning": "text on a primary fill",
      "themed": true,
      "utilities": [
        "bg-primary-foreground",
        "bg-primary-foreground/60",
        "text-primary-foreground"
      ]
    },
    "primary-emphasis": {
      "meaning": "primary as legible text on background, card and accent",
      "themed": true,
      "utilities": [
        "text-primary-emphasis"
      ]
    },
    "secondary": {
      "meaning": "quiet fill",
      "themed": true,
      "utilities": [
        "bg-secondary",
        "bg-secondary/90"
      ]
    },
    "secondary-foreground": {
      "meaning": "text on secondary",
      "themed": true,
      "utilities": [
        "text-secondary-foreground"
      ]
    },
    "muted": {
      "meaning": "quiet fill, skeletons",
      "themed": true,
      "utilities": [
        "bg-muted",
        "bg-muted/30",
        "bg-muted/50",
        "bg-muted/80"
      ]
    },
    "muted-foreground": {
      "meaning": "secondary text (at least 4.5:1 on card)",
      "themed": true,
      "utilities": [
        "bg-muted-foreground",
        "bg-muted-foreground/30",
        "text-muted-foreground",
        "text-muted-foreground/60"
      ]
    },
    "accent": {
      "meaning": "light tint of primary (hover, primary Tag)",
      "themed": true,
      "utilities": [
        "bg-accent"
      ]
    },
    "accent-foreground": {
      "meaning": "text on accent",
      "themed": true,
      "utilities": [
        "text-accent-foreground"
      ]
    },
    "destructive": {
      "meaning": "danger fill and danger text",
      "themed": true,
      "utilities": [
        "bg-destructive",
        "bg-destructive/10",
        "bg-destructive/15",
        "bg-destructive/60",
        "bg-destructive/90",
        "border-destructive",
        "border-destructive/40",
        "ring-destructive/20",
        "ring-destructive/40",
        "text-destructive"
      ]
    },
    "success": {
      "meaning": "success fill and text (status tone)",
      "themed": true,
      "utilities": [
        "bg-success",
        "bg-success/10",
        "bg-success/15",
        "text-success"
      ]
    },
    "warning": {
      "meaning": "warning fill and text",
      "themed": true,
      "utilities": [
        "bg-warning",
        "bg-warning/10",
        "bg-warning/15",
        "text-warning"
      ]
    },
    "info": {
      "meaning": "info fill and text",
      "themed": true,
      "utilities": [
        "bg-info",
        "bg-info/10",
        "bg-info/15",
        "text-info"
      ]
    },
    "brand": {
      "meaning": "identity fill and marks (with /15 tints)",
      "themed": true,
      "utilities": [
        "bg-brand",
        "bg-brand/15",
        "text-brand"
      ]
    },
    "brand-emphasis": {
      "meaning": "brand as legible text",
      "themed": true,
      "utilities": [
        "text-brand-emphasis"
      ]
    },
    "brand-light": {
      "meaning": "light brand tint (brand Tag)",
      "themed": true,
      "utilities": [
        "bg-brand-light",
        "text-brand-light"
      ]
    },
    "brand-ink": {
      "meaning": "brand text at least 4.5:1 (action rows, two-tone titles)",
      "themed": true,
      "utilities": [
        "bg-brand-ink/25",
        "text-brand-ink"
      ]
    },
    "border": {
      "meaning": "hairline; also the default border colour",
      "themed": true,
      "utilities": [
        "bg-border",
        "border-border"
      ]
    },
    "input": {
      "meaning": "field border, dark-mode field fill",
      "themed": true,
      "utilities": [
        "bg-input",
        "bg-input/30",
        "bg-input/50",
        "bg-input/80",
        "border-input"
      ]
    },
    "ring": {
      "meaning": "focus ring",
      "themed": true,
      "utilities": [
        "border-ring",
        "ring-ring",
        "ring-ring/50"
      ]
    },
    "tint": {
      "meaning": "ink at about 6 %, alpha baked in (no /modifier)",
      "themed": true,
      "utilities": [
        "bg-tint"
      ]
    },
    "tint-strong": {
      "meaning": "ink at about 10 %, alpha baked in",
      "themed": true,
      "utilities": [
        "bg-tint-strong"
      ]
    },
    "segment-active": {
      "meaning": "active pill of segmented tabs and toggles",
      "themed": true,
      "utilities": [
        "bg-segment-active"
      ]
    },
    "field-edge": {
      "meaning": "form field edge at rest (about 2:1), alpha baked in",
      "themed": true,
      "utilities": [
        "border-field-edge"
      ]
    },
    "field-edge-strong": {
      "meaning": "field edge on hover and while open (about 3:1)",
      "themed": true,
      "utilities": [
        "border-field-edge-strong"
      ]
    }
  },
  "properties": {
    "--nav-h": {
      "syntax": "<length>",
      "meaning": "height of the fixed top chrome; sticky offsets and full-height frames",
      "themed": false,
      "required": true
    },
    "--content-max": {
      "syntax": "<length-percentage> | none",
      "meaning": "max width of wide forms",
      "themed": false,
      "required": true
    },
    "--radius": {
      "syntax": "<length>",
      "meaning": "base radius; the theme radii sm–xl derive from it",
      "themed": false,
      "required": true
    },
    "--surface-alpha": {
      "syntax": "<percentage>",
      "meaning": "share of the card colour in a .surface",
      "themed": true,
      "required": true
    },
    "--surface-shadow": {
      "syntax": "<shadow>",
      "meaning": "shadow of a .surface and of list cards",
      "themed": true,
      "required": true
    },
    "--surface-shadow-raised": {
      "syntax": "<shadow>",
      "meaning": "shadow of open lists and floating panels (shadow-surface-raised)",
      "themed": true,
      "required": true
    },
    "--glass-alpha": {
      "syntax": "<percentage>",
      "meaning": "share of the card colour in the sticky glass bars (.glass-bar)",
      "themed": true,
      "required": true
    },
    "--surface-glass-alpha": {
      "syntax": "<percentage>",
      "meaning": "share of the card colour in .surface-glass",
      "themed": true,
      "required": true
    },
    "--surface-glass-strong-alpha": {
      "syntax": "<percentage>",
      "meaning": "share of the card colour in .surface-glass-strong and the glass toolbar controls",
      "themed": true,
      "required": true
    },
    "--glass-shadow": {
      "syntax": "<shadow>",
      "meaning": "shadow of the glass tone",
      "themed": true,
      "required": true
    },
    "--glass-control-shadow": {
      "syntax": "<shadow>",
      "meaning": "short shadow of the filter controls on the list toolbar; one value for both themes by default, a host may set a dark value (otherwise .dark inherits it)",
      "themed": false,
      "required": true
    },
    "--segmented-control-radius": {
      "syntax": "<length>",
      "meaning": "corner of SegmentedControl (track, options, indicator); components.css sets 9999px, the pill of the other toggles",
      "themed": false,
      "required": false,
      "default": "9999px"
    },
    "--segmented-control-duration": {
      "syntax": "<time>",
      "meaning": "slide of the SegmentedControl indicator and its colour change; components.css sets 200ms; none with reduced motion",
      "themed": false,
      "required": false,
      "default": "200ms"
    },
    "--sidebar-w": {
      "syntax": "<length>",
      "meaning": "width of the AppShell sidebar column from lg; components.css sets 16rem",
      "themed": false,
      "required": false,
      "default": "16rem"
    },
    "--sidebar-rail-w": {
      "syntax": "<length>",
      "meaning": "width of the collapsed AppShell sidebar (the icon rail); components.css sets 5rem",
      "themed": false,
      "required": false,
      "default": "5rem"
    },
    "--shell-background-base": {
      "syntax": "<color>",
      "meaning": "base colour of ShaderBackground (./shell-background), read by script; falls back to --background",
      "themed": true,
      "required": false,
      "default": "var(--background)"
    },
    "--shell-background-blob-1": {
      "syntax": "<color>",
      "meaning": "first drifting colour of ShaderBackground, read by script; falls back to --brand-light",
      "themed": true,
      "required": false,
      "default": "var(--brand-light)"
    },
    "--shell-background-blob-2": {
      "syntax": "<color>",
      "meaning": "second drifting colour of ShaderBackground, read by script; falls back to --accent",
      "themed": true,
      "required": false,
      "default": "var(--accent)"
    }
  },
  "layers": {
    "--layer-raised": {
      "default": 10,
      "meaning": "sticky table header, search field icons"
    },
    "--layer-sticky": {
      "default": 20,
      "meaning": "sticky form actions and form jump bar"
    },
    "--layer-chrome": {
      "default": 30,
      "meaning": "the AppShell top bar and sidebar: over sticky page bars, under overlays"
    },
    "--layer-overlay": {
      "default": 50,
      "meaning": "dialog and sheet overlay and content"
    },
    "--layer-popover": {
      "default": 50,
      "meaning": "popover, select, dropdown menu, tooltip; equal to the overlay layer, so a later portal paints on top"
    }
  },
  "dataAttributes": {
    "data-page-frame": {
      "setBy": "PageFrame",
      "readBy": "host shell"
    },
    "data-wide-content": {
      "setBy": "EntityListGrid",
      "readBy": "host shell"
    },
    "data-form-actions": {
      "setBy": "FormActions",
      "readBy": "components.css"
    },
    "data-list-toolbar": {
      "setBy": "EntityListCard",
      "readBy": "components.css"
    },
    "data-list-empty": {
      "setBy": "EntityListEmpty",
      "readBy": "components.css"
    },
    "data-entity-grid": {
      "setBy": "EntityListGrid",
      "readBy": "components.css"
    },
    "data-slot": {
      "setBy": "primitives",
      "readBy": "components.css"
    },
    "data-variant": {
      "setBy": "primitives",
      "readBy": "components.css"
    },
    "data-control": {
      "setBy": "primitives and SearchField",
      "readBy": "components.css"
    },
    "data-list-tracks": {
      "setBy": "EntityListTable",
      "readBy": "components.css"
    },
    "data-list-pin": {
      "setBy": "EntityListTable",
      "readBy": "components.css"
    },
    "data-list-pin-edge": {
      "setBy": "EntityListTable",
      "readBy": "components.css"
    },
    "data-list-overflow-start": {
      "setBy": "EntityListTable",
      "readBy": "components.css"
    },
    "data-list-overflow-end": {
      "setBy": "EntityListTable",
      "readBy": "components.css"
    },
    "data-shell": {
      "setBy": "AppShell",
      "readBy": "host shell"
    },
    "data-shell-collapsed": {
      "setBy": "AppShell",
      "readBy": "components.css"
    },
    "data-shell-content": {
      "setBy": "AppShell",
      "readBy": "components.css"
    },
    "data-shell-sidebar": {
      "setBy": "ShellSidebar",
      "readBy": "host shell"
    },
    "data-shell-topbar": {
      "setBy": "ShellTopBar",
      "readBy": "host shell"
    },
    "data-shell-scrolled": {
      "setBy": "ShellTopBar",
      "readBy": "ShellTopBar (frosted bar)"
    },
    "data-shell-background": {
      "setBy": "ShaderBackground",
      "readBy": "host shell"
    },
    "data-nav-key": {
      "setBy": "ShellNavLink",
      "readBy": "host shell (reveal, tests)"
    }
  },
  "hostRequirements": [
    "dark mode: a `.dark` class on an ancestor; the `dark:` variant is defined by the host",
    "default border colour = the `border` role",
    "animation utilities animate-in/out, fade-*, zoom-*, slide-in-from-* (tw-animate-css or equivalent)",
    "colour roles under bare names (`--card: #fff`) can use theme.css as the binding; any other encoding provides the same utility names its own way"
  ]
}
