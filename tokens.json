  "hostRequirements": [
    "dark mode: a `.dark` class on an ancestor; the `dark:` variant is defined by the host",
    "default border colour = the `border` role",
    "animation utilities animate-in/out, fade-*, zoom-*, slide-in-from-* (tw-animate-css or equivalent)",
    "colour roles under bare names (`--card: #fff`) can use theme.css as the binding; any other encoding provides the same utility names its own way"
  ],
  "contrast": {
    "$comment": "Colour pairs the blocks draw, checked by scripts/check-contrast.mjs (ddd-admin-ui-check-contrast) in both themes against WCAG 2.x: minimum 4.5 for text, 3 for large text and UI parts. A background `role/NN` is that role at NN % alpha over `base` (default card), as the status badges draw it. An exception names a pair (and optionally a theme) the blocks accept below its minimum, with the reason. An optional role (`required: false`) that the stylesheet does not declare is evaluated by its `fallback` (a role, or `role/NN` over `base`). A translucent background with a `base` is composited over that base.",
    "pairs": [
      {
        "foreground": "foreground",
        "background": "background",
        "minimum": 4.5,
        "use": "body text on the page"
      },
      {
        "foreground": "card-foreground",
        "background": "card",
        "minimum": 4.5,
        "use": "text on cards"
      },
      {
        "foreground": "popover-foreground",
        "background": "popover",
        "minimum": 4.5,
        "use": "menus, selects, popovers"
      },
      {
        "foreground": "muted-foreground",
        "background": "background",
        "minimum": 4.5,
        "use": "secondary text on the page"
      },
      {
        "foreground": "muted-foreground",
        "background": "card",
        "minimum": 4.5,
        "use": "secondary text on cards"
      },
      {
        "foreground": "primary-foreground",
        "background": "primary",
        "minimum": 4.5,
        "use": "primary buttons, counters"
      },
      {
        "foreground": "secondary-foreground",
        "background": "secondary",
        "minimum": 4.5,
        "use": "quiet buttons, neutral badges"
      },
      {
        "foreground": "accent-foreground",
        "background": "accent",
        "minimum": 4.5,
        "use": "hovered menu items, primary tags"
      },
      {
        "foreground": "primary-emphasis",
        "background": "card",
        "minimum": 4.5,
        "use": "primary as text"
      },
      {
        "foreground": "brand-emphasis",
        "background": "card",
        "minimum": 3,
        "use": "brand marks and large brand text"
      },
      {
        "foreground": "brand-ink",
        "background": "card",
        "minimum": 4.5,
        "use": "brand text, two-tone titles"
      },
      {
        "foreground": "success-text",
        "background": "card",
        "minimum": 4.5,
        "use": "positive deltas, success text on cards"
      },
      {
        "foreground": "success-text",
        "background": "background",
        "minimum": 4.5,
        "use": "positive deltas, success text on the page"
      },
      {
        "foreground": "success-text",
        "background": "success-soft",
        "base": "card",
        "minimum": 4.5,
        "use": "success badge (text on its soft surface over a card)"
      },
      {
        "foreground": "warning-text",
        "background": "card",
        "minimum": 4.5,
        "use": "warning text and notes on cards"
      },
      {
        "foreground": "warning-text",
        "background": "background",
        "minimum": 4.5,
        "use": "warning text and notes on the page"
      },
      {
        "foreground": "warning-text",
        "background": "warning-soft",
        "base": "card",
        "minimum": 4.5,
        "use": "warning badge (text on its soft surface over a card)"
      },
      {
        "foreground": "destructive-text",
        "background": "card",
        "minimum": 4.5,
        "use": "danger text, field errors on cards"
      },
      {
        "foreground": "destructive-text",
        "background": "background",
        "minimum": 4.5,
        "use": "danger text, field errors on the page"
      },
      {
        "foreground": "destructive-text",
        "background": "destructive-soft",
        "base": "card",
        "minimum": 4.5,
        "use": "danger badge (text on its soft surface over a card)"
      },
      {
        "foreground": "info-text",
        "background": "card",
        "minimum": 4.5,
        "use": "info text on cards"
      },
      {
        "foreground": "info-text",
        "background": "background",
        "minimum": 4.5,
        "use": "info text on the page"
      },
      {
        "foreground": "info-text",
        "background": "info-soft",
        "base": "card",
        "minimum": 4.5,
        "use": "info badge (text on its soft surface over a card)"
      }
    ],
    "exceptions": []
  }
}
