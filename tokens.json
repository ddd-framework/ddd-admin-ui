  "properties": {
    "--nav-h": {
      "syntax": "<length>",
      "meaning": "height of the fixed top chrome; sticky offsets and full-height frames",
      "themed": false,
      "required": true
    },
    "--content-max": {
      "syntax": "<length-percentage> | none",
      "meaning": "max width of wide forms",
      "themed": false,
      "required": true
    },
    "--radius": {
      "syntax": "<length>",
      "meaning": "base radius; the theme radii sm–xl derive from it",
      "themed": false,
      "required": true
    },
    "--surface-alpha": {
      "syntax": "<percentage>",
      "meaning": "share of the card colour in a .surface",
      "themed": true,
      "required": true
    },
    "--surface-shadow": {
      "syntax": "<shadow>",
      "meaning": "shadow of a .surface and of list cards",
      "themed": true,
      "required": true
    },
    "--surface-shadow-raised": {
      "syntax": "<shadow>",
      "meaning": "shadow of open lists and floating panels (shadow-surface-raised)",
      "themed": true,
      "required": true
    },
    "--glass-alpha": {
      "syntax": "<percentage>",
      "meaning": "share of the card colour in the sticky glass bars (.glass-bar)",
      "themed": true,
      "required": true
    },
    "--surface-glass-alpha": {
      "syntax": "<percentage>",
      "meaning": "share of the card colour in .surface-glass",
      "themed": true,
      "required": true
    },
    "--surface-glass-strong-alpha": {
      "syntax": "<percentage>",
      "meaning": "share of the card colour in .surface-glass-strong and the glass toolbar controls",
      "themed": true,
      "required": true
    },
    "--glass-shadow": {
      "syntax": "<shadow>",
      "meaning": "shadow of the glass tone",
      "themed": true,
      "required": true
    },
    "--glass-control-shadow": {
      "syntax": "<shadow>",
      "meaning": "short shadow of the filter controls on the list toolbar; one value for both themes by default, a host may set a dark value (otherwise .dark inherits it)",
      "themed": false,
      "required": true
    },
    "--segmented-control-radius": {
      "syntax": "<length>",
      "meaning": "corner of SegmentedControl (track, options, indicator); components.css sets 9999px, the pill of the other toggles",
      "themed": false,
      "required": false,
      "default": "9999px"
    },
    "--segmented-control-duration": {
      "syntax": "<time>",
      "meaning": "slide of the SegmentedControl indicator and its colour change; components.css sets 200ms; none with reduced motion",
      "themed": false,
      "required": false,
      "default": "200ms"
    },
    "--segmented-control-easing": {
      "syntax": "<easing-function>",
      "meaning": "SegmentedControl indicator slide; unset: ease-out",
      "themed": false,
      "required": false
    },
    "--segmented-control-option-duration": {
      "syntax": "<time>",
      "meaning": "SegmentedControl option colour change; unset: --segmented-control-duration",
      "themed": false,
      "required": false
    },
    "--segmented-control-option-easing": {
      "syntax": "<easing-function>",
      "meaning": "SegmentedControl option colour change; unset: the Tailwind default curve",
      "themed": false,
      "required": false
    },
    "--segmented-control-track-duration": {
      "syntax": "<time>",
      "meaning": "SegmentedControl track background change; unset: 0ms",
      "themed": false,
      "required": false
    },
    "--segmented-control-track-easing": {
      "syntax": "<easing-function>",
      "meaning": "SegmentedControl track background change; unset: the Tailwind default curve",
      "themed": false,
      "required": false
    },
    "--segmented-control-coarse-option-height": {
      "syntax": "<length>",
      "meaning": "SegmentedControl coarsePointer=\"grow\": option height and minimum width on a coarse pointer; unset: 44px",
      "themed": false,
      "required": false
    },
    "--segmented-control-coarse-gap": {
      "syntax": "<length>",
      "meaning": "SegmentedControl coarsePointer=\"grow\": gap on a coarse pointer; unset: 8px",
      "themed": false,
      "required": false
    },
    "--segmented-control-held-scale": {
      "syntax": "<number>",
      "meaning": "SegmentedControl pressFeedback: indicator scale while held; unset: 1.06",
      "themed": false,
      "required": false
    },
    "--sidebar-w": {
      "syntax": "<length>",
      "meaning": "width of the AppShell sidebar column from lg; components.css sets 16rem",
      "themed": false,
      "required": false,
      "default": "16rem"
    },
    "--sidebar-rail-w": {
      "syntax": "<length>",
      "meaning": "width of the collapsed AppShell sidebar (the icon rail); components.css sets 5rem",
      "themed": false,
      "required": false,
      "default": "5rem"
    },
    "--shell-background-base": {
      "syntax": "<color>",
      "meaning": "base colour of ShaderBackground (./shell-background), read by script; falls back to --background",
      "themed": true,
      "required": false,
      "default": "var(--background)"
    },
    "--shell-background-blob-1": {
      "syntax": "<color>",
      "meaning": "first drifting colour of ShaderBackground, read by script; falls back to --brand-light",
      "themed": true,
      "required": false,
      "default": "var(--brand-light)"
    },
    "--shell-background-blob-2": {
      "syntax": "<color>",
      "meaning": "second drifting colour of ShaderBackground, read by script; falls back to --accent",
      "themed": true,
      "required": false,
      "default": "var(--accent)"
    }
  },
  "layers": {
    "--layer-raised": {
      "default": 10,
      "meaning": "sticky table header, search field icons"
    },
    "--layer-sticky": {
      "default": 20,
      "meaning": "sticky form actions and form jump bar"
    },
    "--layer-chrome": {
      "default": 30,
      "meaning": "the AppShell top bar and sidebar: over sticky page bars, under overlays"
    },
    "--layer-overlay": {
      "default": 50,
      "meaning": "dialog and sheet overlay and content"
    },
    "--layer-popover": {
      "default": 50,
      "meaning": "popover, select, dropdown menu, tooltip; equal to the overlay layer, so a later portal paints on top"
    }
  },
  "dataAttributes": {
    "data-page-frame": {
      "setBy": "PageFrame",
