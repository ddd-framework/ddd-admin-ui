{
  // Package emit: one JS and one declaration file per source file, directives kept, relative `.ts` / `.tsx`
  // specifiers rewritten to `.js` in the JS (the declarations are fixed up by scripts/build.mjs). Output stays
  // unminified: host Tailwind builds scan dist for class names.
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    // `process.env.NODE_ENV` (the dev-only warning of notify): replaced by the host bundler, typed by @types/node.
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
